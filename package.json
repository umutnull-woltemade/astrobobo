{
  "name": "astrobobo",
  "version": "1.0.0",
  "private": true,
  "description": "Astrobobo - Reflective astrology education platform with zodiac insights, birth chart exploration, and cosmic self-discovery.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:content": "node scripts/validation/content-filter.mjs",
    "lint:compliance": "node scripts/validation/compliance-check.mjs",
    "lint:duplicates": "node scripts/validation/duplicate-detector.mjs",
    "generate:sitemap": "node scripts/seo/generate-sitemap.mjs",
    "generate:content": "node scripts/content-gen/batch-generate.mjs",
    "db:migrate": "node db/migrations/run.mjs",
    "db:rollback": "node db/migrations/rollback.mjs",
    "agents:start": "bash scripts/tmux/start-agents.sh",
    "agents:stop": "bash scripts/tmux/stop-agents.sh",
    "validate:all": "npm run lint:content && npm run lint:compliance && npm run lint:duplicates",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/postcss": "^4.0.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.1.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.33.2",
    "tailwindcss": "^4.0.0",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

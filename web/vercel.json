    { "source": "/premium", "destination": "/index.html" },
    { "source": "/kozmoz", "destination": "/index.html" },
    { "source": "/dreams", "destination": "/index.html" },
    { "source": "/dreams/:path*", "destination": "/index.html" },
    { "source": "/chakra", "destination": "/index.html" },
    { "source": "/rituals", "destination": "/index.html" },
    { "source": "/aura", "destination": "/index.html" },
    { "source": "/kabbalah", "destination": "/index.html" },
    { "source": "/compatibility", "destination": "/index.html" },
